# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace 'YOUR_IP_ADDRESS' with your machine's actual IP
#    - Windows: run 'ipconfig'
#    - Linux:   run 'ip addr'
#    - Mac:     run 'ifconfig'
# ==============================================================================
# IMPORTANT: Never commit your actual .env file to version control.
#            Only .env.example should be committed.
# ==============================================================================

# --- NGINX CONFIGURATION ---
NGINX_PORT=3000
NGINX_SSL_PORT=3443

# --- SERVER CONFIGURATION ---
SERVER_NAME=YOUR_IP_ADDRESS
SERVER_ENV=development

# --- BACKEND API CONFIGURATION ---
BACKEND_APP_API_URL=http://YOUR_IP_ADDRESS:8000

# --- SSL CONFIGURATION ---
# Required if you are testing local HTTPS/SSL setups
SSL_LOCATION=./certs

# --- DEVELOPMENT MODE ---
MODE=development

# --- VITE DEVELOPMENT SERVER ---
# 0.0.0.0 allows the server to be accessible over the local network
VITE_DEV_HOST=0.0.0.0

# --- HOT MODULE RELOAD (HMR) ---
# Required for HMR to sync across network devices
VITE_HMR_HOST=YOUR_IP_ADDRESS

# --- API BASE URL ---
# MUST be an absolute URL
VITE_API_BASE_URL=http://YOUR_IP_ADDRESS:8000/api/v1